# Server Environment Variables

# Port for the Node.js server to listen on.
PORT=5000

# MongoDB connection URI. Replace with your actual MongoDB connection string.
# Example for local MongoDB: mongodb://localhost:27017/blogdb
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/blogdb?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Secret key for signing JSON Web Tokens (JWTs).
# Generate a strong, random string for production.
JWT_SECRET=your_jwt_secret_key

# Expiration time for JWTs (e.g., '1h', '7d', '30m').
JWT_EXPIRES_IN=1d

# Node environment (e.g., 'development', 'production', 'test').
NODE_ENV=development

# Client Environment Variables

# Base URL for the backend API.
# In development, this might be your local server address.
# In production, this would be your deployed backend URL.
# Note: React apps require environment variables to be prefixed with REACT_APP_
REACT_APP_API_BASE_URL=http://localhost:5000/api