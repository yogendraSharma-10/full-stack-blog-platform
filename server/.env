# Server Environment Variables

# Port the server will listen on
PORT=5000

# MongoDB Connection URI
# Replace <username>, <password>, <cluster-name>, and <database-name> with your actual MongoDB Atlas or local credentials.
# Example for local MongoDB: MONGODB_URI=mongodb://localhost:27017/blogdb
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# JSON Web Token (JWT) Secret for authentication
# Generate a strong, random secret for production.
# Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration Time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=1d

# CORS Origin - URL of your client application
# This allows your frontend to make requests to the backend.
# For development, it's typically http://localhost:3000
# For production, replace with your deployed frontend URL (e.g., https://yourblog.com)
CORS_ORIGIN=http://localhost:3000