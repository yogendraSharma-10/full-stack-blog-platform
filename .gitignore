# Gitignore for Full-Stack Blog Platform

# Node.js specific ignores
# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
# Keep .env.example but ignore actual .env files
.env
client/.env
client/.env.development
client/.env.production
server/.env
server/.env.development
server/.env.production

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Build artifacts
dist/
build/
client/build/
client/dist/

# Editor/IDE specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# npm package manager specific
package-lock.json
yarn.lock
# If you use pnpm
pnpm-lock.yaml

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Other common ignores
# Coverage reports
coverage/
client/coverage/
server/coverage/

# Test results
*.test.js.snap
*.spec.js.snap

# Temporary files
*.tmp
*~
~*

# Uploaded files (if any are stored locally outside of a database)
# For example, if user avatars or post images are stored on the file system
# uploads/
# client/public/uploads/

# Docker related (if using local docker-compose for dev)
# .dockerignore (this file itself should be committed)
# docker-compose.override.yml (if it contains sensitive info or local dev specific overrides)

# CI/CD specific (if any local files are generated by CI tools)
.nyc_output/